# Copy to apps/api/.env for local development. NEVER commit a real .env.
# Values below match infra/docker/docker-compose.dev.yml.

NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api/v1

# MongoDB — single-node replica set (required for multi-document transactions).
MONGODB_URI=mongodb://localhost:27017/lanyard?replicaSet=rs0&directConnection=true

# Redis (queues/cache) — used from later phases.
REDIS_URL=redis://localhost:6379

# Object storage (MinIO in dev) — prescriptions & documents.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lanyard-dev
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
PRESCRIPTION_MAX_FILE_MB=10

# Web origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth. JWT_SECRET is REQUIRED (min 16 chars). Use a long random value per environment;
# production should move to asymmetric RS256 keys (see docs/architecture/07).
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_ISSUER=lanyard
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# SMS delivery. In development/test, OTPs still return devCode and SMS sends log locally.
# In production, configure a real Sendchamp sender.
SENDCHAMP_ACCESS_KEY=
SENDCHAMP_SENDER_NAME=
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1
SENDCHAMP_SMS_ROUTE=non_dnd

# SMTP delivery. Production should set host/port/from and auth if required.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@lanyardpharmacy.com
RESEND_FROM_NAME=Lanyard Pharmacy

# Payments — Paystack (test keys in staging; live only in prod secrets).
# Paystack signs webhooks with PAYSTACK_SECRET_KEY; there is no separate webhook secret.
PAYSTACK_SECRET_KEY=
