IMAGE_REGISTRY=ghcr.io/moyowalker/lanyard-systems
IMAGE_TAG=replace-with-full-git-sha
ACME_EMAIL=operations@lanyardpharmacy.com

MONGODB_URI=mongodb+srv://replace-me
REDIS_PASSWORD=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=lanyard
CORS_ORIGINS=https://lanyardpharmacy.com,https://www.lanyardpharmacy.com,https://store.lanyardpharmacy.com,https://admin.lanyardpharmacy.com

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=replace-me
S3_FORCE_PATH_STYLE=false

SENDCHAMP_ACCESS_KEY=replace-me
SENDCHAMP_SENDER_NAME=Lanyard
SMTP_HOST=
