SMTP_FROM=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=notifications@lanyardpharmacy.com
